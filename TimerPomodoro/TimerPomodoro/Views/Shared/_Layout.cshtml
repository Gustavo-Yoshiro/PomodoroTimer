<!DOCTYPE html>
<html ng-app="timerApp">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>@ViewBag.Title - Pomodoro Timer</title>

	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="~/Content/style.css" rel="stylesheet">
</head>
<body>
	<nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
		<div class="container">
			@Html.ActionLink("Pomodoro Timer", "Index", "Timer", new { area = "" }, new { @class = "navbar-brand" })
		</div>
	</nav>

	<div class="container body-content mt-4">
		@RenderBody()
		<hr />
		<footer>
			<p>&copy; @DateTime.Now.Year - Pomodoro Timer </p>
		</footer>
	</div>

	<script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"></script>

	<script src="~/Scripts/timerApp.js"></script>

	@RenderSection("scripts", required: false)
</body>
</html>